def get_account_summary(account_number):
    """
    Get a summary of key information for a specific account.
    """
    account_data = get_account_data(account_number)
    
    if account_data.empty:
        print(f"No data found for account {account_number}")
        return None
    
    print(f"=== Account {account_number} Summary ===")
    print(f"Years of data: {account_data['year'].min()} - {account_data['year'].max()}")
    print(f"Total records: {len(account_data)}")
    
    # Building information (should be consistent)
    building_info = account_data[['year_built', 'construction_quality', 'building_condition', 
                                 'hvac', 'building_type']].iloc[0]
    print(f"\nBuilding Information:")
    for col, val in building_info.items():
        if pd.notna(val):
            print(f"  {col}: {val}")
    
    # Sales information
    sales_data = account_data[account_data['sale_price'].notna()]
    if not sales_data.empty:
        print(f"\nSales History ({len(sales_data)} sales):")
        for _, sale in sales_data.iterrows():
            print(f"  {sale['year']}: ${sale['sale_price']:,} (Month: {sale['sale_month']})")
    else:
        print("\nNo sales data available")
    
    # Value trends
    print(f"\nProperty Value Trends:")
    print(f"  Latest total value ({account_data['year'].max()}): ${account_data['total_value'].iloc[-1]:,}")
    print(f"  Latest land value: ${account_data['land_value'].iloc[-1]:,}")
    print(f"  Latest building value: ${account_data['building_value'].iloc[-1]:,}")
    
    return account_data# Function to extract comprehensive data for specific account numbers
def get_account_data(account_numbers, include_sales_only=False):
    """
    Extract comprehensive data for specific account numbers.
    
    Parameters:
    - account_numbers: int or list of ints - Account number(s) to extract
    - include_sales_only: bool - If True, only return records with sales data
    
    Returns:
    - DataFrame with all available data for the specified account(s)
    """
    if isinstance(account_numbers, int):
        account_numbers = [account_numbers]
    
    # Filter master_df for the specified account numbers
    account_data = master_df[master_df['account_num'].isin(account_numbers)].copy()
    
    if include_sales_only:
        # Only return records where there was an actual sale
        account_data = account_data[account_data['sale_price'].notna()]
    
    # Sort by account number and year for better readability
    account_data = account_data.sort_values(['account_num', 'year'])
    
    return account_data{
