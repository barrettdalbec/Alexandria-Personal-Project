def analyze_sales_by_accounts(account_numbers, min_year=2010):
    """
    Analyze sales patterns for multiple accounts.
    """
    # Get data for all specified accounts with sales only
    sales_data = get_account_data(account_numbers, include_sales_only=True)
    
    # Filter by minimum year if specified
    if min_year:
        sales_data = sales_data[sales_data['year'] >= min_year]
    
    if sales_data.empty:
        print("No sales data found for the specified accounts and criteria.")
        return None
    
    print(f"=== Sales Analysis for {len(account_numbers)} Accounts ===")
    print(f"Total sales found: {len(sales_data)}")
    print(f"Year range: {sales_data['year'].min()} - {sales_data['year'].max()}")
    
    # Sales by year
    print(f"\nSales by Year:")
    yearly_sales = sales_data.groupby('year').agg({
        'sale_price': ['count', 'mean', 'median', 'sum']
    }).round(0)
    yearly_sales.columns = ['Count', 'Avg_Price', 'Median_Price', 'Total_Value']
    print(yearly_sales)
    
    # Building type analysis
    if 'building_type' in sales_data.columns:
        print(f"\nSales by Building Type:")
        building_sales = sales_data.groupby('building_type').agg({
            'sale_price': ['count', 'mean']
        }).round(0)
        building_sales.columns = ['Count', 'Avg_Price']
        print(building_sales)
    
    return sales_data

