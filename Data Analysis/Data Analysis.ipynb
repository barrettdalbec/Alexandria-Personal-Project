   "outputs": [],
   "source": [
    "# Create a comprehensive merged dataset by account number
# Step 1: Start with yearly values as the base (most comprehensive data)
print("Starting merge process...")
print(f"Yearly values shape: {yearly_values_df.shape}")
print(f"Sales data shape: {sales_data_df.shape}")
print(f"Building descriptions shape: {building_descriptions_df.shape}")

# Step 2: Merge building descriptions (one-to-many: one building description per account)
master_df = yearly_values_df.merge(
    building_descriptions_df, 
    on='account_num', 
    how='left'
)
print(f"After merging building descriptions: {master_df.shape}")

# Step 3: Merge sales data (many-to-many: multiple sales per account per year)
master_df = master_df.merge(
    sales_data_df, 
    on=['account_num', 'year'], 
    how='left'
)
print(f"After merging sales data: {master_df.shape}")
print("\nMerge completed successfully!")"
   ]
  },
